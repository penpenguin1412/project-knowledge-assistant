# This application reads process environment variables, not .env files automatically.
# Use PowerShell $env:NAME='value' or POSIX export NAME='value'. Never commit real secrets.
LLM_ENABLED=0
LLM_PROVIDER=openai_compatible
# For a trusted local Codex client: LLM_PROVIDER=codex, LLM_MODEL=gpt-6-astra.
# Requires official Codex CLI on PATH (or CODEX_BIN) and codex login.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
ASSISTANT_TOKEN=
